{
    "task": [
        {
            "name": "✈️世界之外启动",
            "entry": "启动世界之外",
            "controller": ["ADB模拟器"],
            "default_check": true,
            "option": ["请选择游戏版本", "使用指定账号登录"],
            "description": "目前官服可以成功启动，其他渠道的需要反馈区服<br>不支持PlayCover，仅支持ADB模拟器<br>使用指定账号登录时,必须保证<span style=\"color:red\">分辨率为900x1600-320DPI-手机</span>，"
        },
        {
            "name": "♻主页面切换账号",
            "entry": "启动切换账号",
            "controller": ["ADB模拟器", "PlayCover"],
            "default_check": false,
            "option": ["请选择游戏版本", "账号前3位"],
            "description": "使用指定账号登录时,必须保证<span style=\"color:red\">分辨率为900x1600-320DPI-手机</span>，"
        }
    ],
    "option": {
        "请选择游戏版本": {
            "type": "select",
            "cases": [
                {
                    "name": "世界之外官服",
                    "pipeline_override": {
                        "世界之外官服": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "世界之外台服",
                    "pipeline_override": {
                        "世界之外台服": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "使用指定账号登录": {
            "type": "switch",
            "description": "可只填1-2位连续内容，避开易混淆的字符（如Oo、Ss大小写不分、1lI认错等）",
            "cases": [
                {
                    "name": "No",
                    "pipeline_override": {
                        "切换账号启动": {
                            "enabled": false
                        }
                    }
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "切换账号启动": {
                            "enabled": true
                        }
                    },
                    "option": ["账号前3位"]
                }
            ]
        },
        "账号前3位": {
            "type": "input",
            "inputs": [
                {
                    "name": "account",
                    "description": "可只填1-2位连续内容，避开易混淆的字符（如Oo、Ss大小写不分、1lI认错等）",
                    "label": "帐号前3位中的任意内容",
                    "pipeline_type": "string",
                    "default": "xxx"
                }
            ],
            "pipeline_override": {
                "选择登录账号": {
                    "expected": ["{account}"],
                    "focus": {
                        "Node.Action.Succeeded": "登录账号：{account}"
                    }
                },
                "确认已切好账号": {
                    "expected": ["{account}"]
                }
            }
        }
    }
}
